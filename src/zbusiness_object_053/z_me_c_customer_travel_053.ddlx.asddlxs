@Metadata.layer: #INDUSTRY
@UI:{ headerInfo: { typeName: 'Customer',
                    typeNamePlural: 'Customers',
                    title: { type: #STANDARD,
                             value: 'CustomerId'
                           } 
                   },
                     presentationVariant: [ { sortOrder: 
                                            [ { by : 'CustomerId',
                                                direction: #ASC
                                              } ]                 
                                            } ]            
   } 
annotate entity Z_C_CUSTOMER_TRAVEL_053
    with 
{
    @UI.facet: [{
                  id : 'CustomerDetails',
                  purpose: #STANDARD,
                  type: #IDENTIFICATION_REFERENCE,
                  label: 'Customer Details',
                  position: 10
                 }]

